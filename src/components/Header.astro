---
import { SITE, NAV, CTA, isOn } from '../config';
import { t, pick, pageHref, getLocale } from '../i18n/index.ts';
import LangSwitch from './LangSwitch.astro';
const locale = getLocale(Astro);
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(pageHref(locale, href).replace(/\/$/, ''));
const nav = NAV.filter((l) => isOn(l.feature)).map((l) => ({
  ...l,
  children: l.children?.filter((c) => isOn(c.feature)),
}));
const external = (url: string) => /^https?:/.test(url);
---

<header class="g-header">
  <nav class="g-container g-nav" aria-label={t(locale, 'primaryNav')}>
    <a class="g-brand" href={pageHref(locale, '/')}>
      {SITE.logo && <img src={SITE.logo} alt={pick(locale, SITE.title)} />}
      <span class="g-brand__text">
        <span class="g-brand__name">{SITE.brandName}</span>
        {SITE.brandSub && <span class="g-brand__sub">{SITE.brandSub}</span>}
      </span>
    </a>

    <button class="g-nav__toggle" aria-label={t(locale, 'toggleMenu')} aria-expanded="false">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <ul class="g-navlinks">
      {nav.map((l) =>
        l.children?.length ? (
          <li class="has-sub">
            <a
              href={pageHref(locale, l.href)}
              class={isActive(l.href) || l.children.some((c) => isActive(c.href)) ? 'is-active' : ''}
            >
              {pick(locale, l.label)}<i class="fa-solid fa-chevron-down g-navlinks__caret" aria-hidden="true"></i>
            </a>
            <ul class="g-navlinks__sub">
              {l.children.map((c) => (
                <li><a href={pageHref(locale, c.href)} class={isActive(c.href) ? 'is-active' : ''}>{pick(locale, c.label)}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a href={pageHref(locale, l.href)} class={isActive(l.href) ? 'is-active' : ''}>{pick(locale, l.label)}</a></li>
        )
      )}
    </ul>

    {!Astro.url.pathname.startsWith('/404') && <LangSwitch />}

    <a
      class="g-btn g-btn--primary g-btn--sm g-nav__cta"
      href={pageHref(locale, CTA.url)}
      {...(external(CTA.url) ? { rel: 'noopener', target: '_blank' } : {})}
    >
      {CTA.icon && <i class={CTA.icon} aria-hidden="true"></i>}{pick(locale, CTA.label)}
    </a>
  </nav>
</header>
