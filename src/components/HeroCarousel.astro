---
/** Home hero photos, one at a time. The first photo is in the HTML; the
 *  others are `hidden` until public/scripts/hero-carousel.js runs. A
 *  pause/play button controls the rotation (WCAG 2.2.2), and the rotation
 *  starts paused for visitors who prefer reduced motion. */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import MockBadge from './MockBadge.astro';
import { HERO_INTERVAL_MS } from '../config';
import { t, pick, getLocale } from '../i18n/index.ts';
const locale = getLocale(Astro);

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hero/*.{jpg,jpeg,png,webp}', { eager: true });
const photos = (await getCollection('heroPhotos')).map((p) => {
  const img = files[`/src/assets/hero/${p.data.file}`];
  if (!img) throw new Error(`src/data/hero-photos.json: ${p.id} names "${p.data.file}", which is not in src/assets/hero/`);
  return { ...p.data, img: img.default };
});
---

{photos.length > 0 && (
  <div
    class="kd-carousel"
    aria-roledescription="carousel"
    aria-label={t(locale, 'carousel.label')}
    data-interval={HERO_INTERVAL_MS}
  >
    {photos.map((p, i) => (
      <figure class="kd-carousel__slide" hidden={i > 0}>
        <Image src={p.img} alt={pick(locale, p.alt)} widths={[640, 960, 1280]} sizes="(min-width: 960px) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        <figcaption>{t(locale, 'mock.photo')} {p.mock && <MockBadge />}</figcaption>
      </figure>
    ))}
    {photos.length > 1 && (
      <button
        type="button"
        class="g-btn g-btn--sm g-btn--secondary kd-carousel__toggle"
        data-label-pause={t(locale, 'carousel.pause')}
        data-label-play={t(locale, 'carousel.play')}
        hidden
      >{t(locale, 'carousel.pause')}</button>
    )}
  </div>
)}
<script src="/scripts/hero-carousel.js" is:inline defer></script>
