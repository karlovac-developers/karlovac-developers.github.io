---
import type { CollectionEntry } from 'astro:content';
import { pageHref, getLocale } from '../i18n/index.ts';
const locale = getLocale(Astro);

interface Props { organizer: CollectionEntry<'organizers'> }
const { organizer } = Astro.props;
const d = organizer.data;
---

<div class="g-org">
  {d.photo && <a href={pageHref(locale, `/organizers/${organizer.id}/`)}><img class="g-org__img" src={pageHref(locale, d.photo)} alt={d.title} loading="lazy" decoding="async" /></a>}
  <div class="g-org__name"><a href={pageHref(locale, `/organizers/${organizer.id}/`)} style="color:inherit">{d.title}</a></div>
  {d.role && <div class="g-org__role">{d.role}</div>}
  {d.description && <p class="g-org__bio">{d.description}</p>}
  {d.social.length > 0 && (
    <div class="g-persona__socials">
      {d.social.map((s) => (
        <a href={pageHref(locale, s.url)} aria-label={s.label} rel="noopener" target="_blank"><i class={s.icon} aria-hidden="true"></i></a>
      ))}
    </div>
  )}
</div>
