---
import { FEATURES } from '../config';
import MockBadge from './MockBadge.astro';
import { isUpcoming } from '../lib/dates.ts';
import type { CollectionEntry } from 'astro:content';
import { safeCollection } from '../lib/collections';
import { eventHasRecording } from '../lib/talks';
import { t, pageHref, formatDate, getLocale } from '../i18n/index.ts';
const locale = getLocale(Astro);

interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const d = event.data;
const hasRecording = eventHasRecording(d);

/* Venue: a venueRef to the venues collection wins over the flat fields. */
const venuePage = d.venueRef ? (await safeCollection('venues')).find((v) => v.id === d.venueRef) : undefined;
if (d.venueRef && !venuePage) console.warn(`events/${event.id}: venueRef "${d.venueRef}" matches no venue page`);
const venueName = venuePage?.data.title ?? d.venue;
const venueAddress = venuePage?.data.address ?? (venuePage ? undefined : d.address);
/* Venue-wanted only matters for events still to come: a past event with no
   recorded venue shows neither badge nor "to be announced". */
const upcoming = isUpcoming(d.date, new Date());
/* Events synced from Meetup's calendar carry no venue; it is on the Meetup page. */
const venueOnMeetup = !venueName && !d.venueWanted && !!d.meetupUrl;
const tbd = upcoming && (d.venueWanted || (!venueName && !venueOnMeetup));
const lang = d.lang !== locale ? d.lang : undefined;
/* Planning: the event is on the calendar but its details are not settled.
   Wins over the venue-wanted badge, which is inferred, and hides the RSVP
   button even when `rsvp` is already filled in. */
const planning = d.planning;

/* Speaker line: resolved speaker-profile names, falling back to the string. */
const allSpeakers = d.speakers.length ? await safeCollection('speakers') : [];
const names = d.speakers.map((slug) => {
  const found = allSpeakers.find((s) => s.id === slug);
  if (!found) console.warn(`events/${event.id}: speaker "${slug}" matches no speaker page`);
  return found?.data.title;
}).filter(Boolean);
const speakerLine = FEATURES.speakers && names.length ? names.join(', ') : d.speaker;

const dow = formatDate(d.date, locale, { weekday: 'short' });
const day = formatDate(d.date, locale, { month: 'short', day: 'numeric' });
---

<div class="g-event">
  <div class="g-event__date">
    <span class="g-event__dow">{dow}</span>
    <span class="g-event__day">{day}</span>
    {d.time && <span class="g-event__time">{d.time}</span>}
  </div>
  <div class="g-event__body">
    {d.tags.length > 0 && (
      <div class="g-card__footer" style="padding-top:0">
        {d.tags.map((tag) => <span class="g-tag">{tag}</span>)}
      </div>
    )}
    <h3><a href={pageHref(locale, `/events/${event.id}/`)} style="color:inherit" lang={lang}>{d.title}</a> {d.mock && <MockBadge />}</h3>
    {d.description && <p lang={lang}>{d.description}</p>}
    {(venueName || upcoming) && (
      <div class="g-event__meta">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        {venueName
          ? <span lang={lang}>{venueName}{venueAddress && ` · ${venueAddress}`}</span>
          : venueOnMeetup ? <a href={d.meetupUrl} rel="noopener" target="_blank">{t(locale, 'venueOnMeetup')}</a> : t(locale, 'venueTba')}
      </div>
    )}
    {speakerLine && (
      <div class="g-event__meta"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i>{speakerLine}</div>
    )}
    {hasRecording && (
      <div class="g-event__meta"><i class="fa-solid fa-circle-play" aria-hidden="true"></i>{t(locale, 'hasRecording')}</div>
    )}
  </div>
  <div class="g-event__aside">
    {d.cancelled
      ? <span class="g-badge g-badge--danger g-badge--soft">{t(locale, 'eventCancelled')}</span>
      : planning
      ? <span class="g-badge g-badge--soft">{t(locale, 'eventPlanning')}</span>
      : tbd
      ? <span class="g-badge g-badge--warning g-badge--soft">{t(locale, 'venueWanted')}</span>
      : upcoming
      ? <span class="g-badge g-badge--success g-badge--soft">{t(locale, 'confirmed')}</span>
      : null}
    {!planning && d.rsvp && (
      <a class="g-btn g-btn--primary g-btn--sm" href={pageHref(locale, d.rsvp)}><i class="fa-solid fa-calendar" aria-hidden="true"></i>{t(locale, 'rsvp')}</a>
    )}
  </div>
</div>
