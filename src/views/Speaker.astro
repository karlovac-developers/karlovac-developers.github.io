---

import { render } from 'astro:content';
import { safeCollection } from '../lib/collections';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AuthorBox from '../components/AuthorBox.astro';
import EventRow from '../components/EventRow.astro';
import { t, getLocale } from '../i18n/index.ts';
const locale = getLocale(Astro);


const { entry } = Astro.props;
const entryLang = entry.data.lang !== locale ? entry.data.lang : undefined;
const { Content } = await render(entry);
const events = (await safeCollection('events'))
  .filter((e) => !e.data.draft && e.data.speakers.includes(entry.id))
  .sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout langRule={{ entryLang: entry.data.lang }} title={entry.data.title} description={entry.data.bio}>
  <PageHero lang={entryLang} mock={entry.data.mock} eyebrow={t(locale, 'eyebrowSpeaker')} backHref="/speakers/" backLabel={t(locale, 'allSpeakers')} title={entry.data.title} />
  <section class="g-bg-white g-section">
    <div class="g-container">
      <div class="g-article" style="margin-bottom:var(--space-5)">
        <AuthorBox entry={entry} base="/speakers/" />
        <div class="g-prose" style="margin-top:var(--space-4)" lang={entryLang} data-entry-lang={entryLang}><Content /></div>
      </div>
      {events.length > 0 && (
        <>
          <div class="g-section-head"><span class="g-eyebrow">{t(locale, 'eyebrowEvents')}</span><h2>{t(locale, 'sessionsBy').replace('{name}', entry.data.title)}</h2></div>
          <div class="g-stack" style="margin-top:var(--space-4);gap:var(--space-3)">
            {events.map((e) => <EventRow event={e} />)}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>
