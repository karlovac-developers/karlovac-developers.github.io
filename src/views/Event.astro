---
import { SITE, FEATURES } from '../config';
import MockBadge from '../components/MockBadge.astro';
import { buildEventLd, jsonld } from '../lib/eventld';
import { absoluteUrl } from '../lib/url';
import { render } from 'astro:content';
import { safeCollection } from '../lib/collections';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { eventTalks } from '../lib/talks';
import { t, pick, pageHref, formatDate, getLocale } from '../i18n/index.ts';
const locale = getLocale(Astro);


const { event } = Astro.props;
const d = event.data;
const entryLang = d.lang !== locale ? d.lang : undefined;
const { Content } = await render(event);
const dateStr = formatDate(d.date, locale, { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric' });

/* Venue: a venueRef to the venues collection wins over the flat fields;
   its arrival notes are inherited unless the event sets venueNotes. */
const venuePage = d.venueRef ? (await safeCollection('venues')).find((v) => v.id === d.venueRef) : undefined;
if (d.venueRef && !venuePage) throw new Error(`events/${event.id}: venueRef "${d.venueRef}" matches no venue page`);
const venueNotes = d.venueNotes ?? venuePage?.data.notes;

/* Speaker profile cards, resolved from the speakers collection. */
const allSpeakers = await safeCollection('speakers');
const speakerEntries = d.speakers.map((slug) => {
  const entry = allSpeakers.find((s) => s.id === slug);
  if (!entry) throw new Error(`events/${event.id}: speaker "${slug}" matches no speaker page`);
  return entry;
});

/* §3 talks: multi-talk events render a Talks section; single-talk events
   render recording/slides links inline in the meta block. */
const talks = eventTalks(d, allSpeakers, event.id);
const hasTalksArray = !!(d.talks && d.talks.length > 0);

/* schema.org/Event JSON-LD (see lib/eventld; contract in PARITY.md). */
const siteUrl = absoluteUrl('/', Astro.site ?? Astro.url);
const permalink = absoluteUrl(`/events/${event.id}/`, Astro.site ?? Astro.url);
const eventLd = jsonld(buildEventLd({
  title: d.title,
  date: d.date,
  time: d.time,
  description: d.description,
  cancelled: (d as any).cancelled,
  online: (d as any).online,
  price: (d as any).price,
  currency: (d as any).currency,
  cost: (d as any).cost,
  image: d.image ? absoluteUrl(d.image, Astro.site ?? Astro.url) : undefined,
  rsvp: d.rsvp,
  permalink,
  siteUrl,
  siteTitle: pick(locale, SITE.title),
  defaultCurrency: (SITE as Record<string, any>).seo?.currency ?? 'USD',
  venue: venuePage ? { name: venuePage.data.title, address: venuePage.data.address } : undefined,
  performers: speakerEntries.map((s) => s.data.title),
}));
---

<BaseLayout langRule={{ entryLang: d.lang }} title={d.title} description={d.description} image={d.image}>
  <script type="application/ld+json" slot="head" set:html={eventLd} />
  <article>
    <header class="g-pagehero">
      <div class="g-container" style="padding-block:var(--space-6) var(--space-5)">
        <div style="margin-bottom:1rem">
          <a href={pageHref(locale, '/events/')} style="display:inline-flex;gap:.4rem;align-items:center;font-size:var(--text-sm);font-weight:var(--weight-medium)">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {t(locale, 'allEvents')}
          </a>
        </div>
        <span class="g-eyebrow">{dateStr}{d.time && ` · ${d.time}`}</span>
        <h1 style="margin:.5rem 0 0"><span lang={entryLang}>{d.title}</span>{d.mock && <> <MockBadge /></>}{d.cancelled ? <> <span class="g-badge g-badge--danger" style="vertical-align:middle;font-size:var(--text-sm)">{t(locale, 'eventCancelled')}</span></> : d.planning ? <> <span class="g-badge g-badge--soft" style="vertical-align:middle;font-size:var(--text-sm)">{t(locale, 'eventPlanning')}</span></> : null}</h1>
      </div>
    </header>
    <div class="g-container g-section--sm">
     <div class="g-article">
      <div class="g-meta-line" style="margin-bottom:var(--space-4)">
        <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {venuePage
          ? <>{FEATURES.venues ? <a href={pageHref(locale, `/venues/${venuePage.id}/`)}>{venuePage.data.title}</a> : venuePage.data.title}{venuePage.data.address && ` · ${venuePage.data.address}`}</>
          : <>{d.venue ?? t(locale, 'venueTba')}{d.address && ` · ${d.address}`}</>}</span>
        {venuePage?.data.wheelchair && <span><span class="g-badge g-badge--success g-badge--soft"><i class="fa-solid fa-wheelchair" aria-hidden="true"></i> {t(locale, 'wheelchairAccessible')}</span></span>}
        {FEATURES.venues && venuePage && (venuePage.data.transit || venuePage.data.parking || venuePage.data.access) && <span><a href={pageHref(locale, `/venues/${venuePage.id}/`)}>{t(locale, 'gettingThere')}</a></span>}
        {d.speaker && <span><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> {d.speaker}</span>}
        {!hasTalksArray && d.recording && <span><a href={pageHref(locale, d.recording)} rel="noopener" target="_blank"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> {t(locale, 'watchRecording')}</a></span>}
        {!hasTalksArray && d.slides && <span><a href={pageHref(locale, d.slides)} rel="noopener" target="_blank"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> {t(locale, 'viewSlides')}</a></span>}
      </div>

      {(d.checkin || venueNotes) && (
        <div class="g-callout" style="flex-direction:column;gap:.6rem;margin:0 0 var(--space-4)">
          <div class="g-callout__title">{t(locale, 'beforeYouArrive')}</div>
          {d.checkin && <div class="g-callout__body"><i class="fa-solid fa-ticket" aria-hidden="true"></i> {d.checkin}</div>}
          {venueNotes && <div class="g-callout__body"><i class="fa-solid fa-door-open" aria-hidden="true"></i> {venueNotes}</div>}
        </div>
      )}

      <div class="g-prose" lang={entryLang} data-entry-lang={entryLang}><Content /></div>

      {speakerEntries.length > 0 && (
        <>
          <h2 style="font-size:var(--text-xl);margin:var(--space-5) 0 1rem">{t(locale, 'speakers')}</h2>
          <div class="g-stack" style="gap:var(--space-3)">
            {speakerEntries.map((s) => <AuthorBox entry={s} base="/speakers/" />)}
          </div>
        </>
      )}

      {hasTalksArray && (
        <>
          <h2 style="font-size:var(--text-xl);margin:var(--space-5) 0 1rem">{t(locale, 'talks')}</h2>
          <div class="g-stack" style="gap:var(--space-3)">
            {talks.map((talk) => (
              <div class="g-talk">
                <div class="g-talk__title">{talk.title}</div>
                {talk.speakerName && (
                  <div class="g-talk__by"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> {FEATURES.speakers && talk.speakerSlug ? <a href={pageHref(locale, `/speakers/${talk.speakerSlug}/`)}>{talk.speakerName}</a> : talk.speakerName}</div>
                )}
                {(talk.recording || talk.slides) && (
                  <div class="g-row" style="gap:var(--space-2)">
                    {talk.recording && <a class="g-btn g-btn--sm g-btn--outline" href={pageHref(locale, talk.recording)} rel="noopener" target="_blank"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> {t(locale, 'watchRecording')}</a>}
                    {talk.slides && <a class="g-btn g-btn--sm g-btn--ghost" href={pageHref(locale, talk.slides)} rel="noopener" target="_blank"><i class="fa-solid fa-file-lines" aria-hidden="true"></i> {t(locale, 'viewSlides')}</a>}
                  </div>
                )}
              </div>
            ))}
          </div>
        </>
      )}

      {/* An event still being planned takes no RSVPs yet, even with `rsvp` set. */}
      {!d.planning && d.rsvp && (
        <div class="g-row" style="margin-top:var(--space-4)">
          <a class="g-btn g-btn--primary g-btn--lg" href={pageHref(locale, d.rsvp)}><i class="fa-solid fa-calendar" aria-hidden="true"></i> {t(locale, 'rsvpExternal')}</a>
        </div>
      )}
     </div>
    </div>
  </article>
</BaseLayout>
